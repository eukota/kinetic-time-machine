# Production secrets — copy this file to .env on the server (DO NOT commit .env)
#
# Generate a random admin token, e.g.:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=

# hCaptcha — get keys from hcaptcha.com (free signup, ~30 sec)
# - HCAPTCHA_SITEKEY is the PUBLIC key (frontend sees it via /api/config)
# - HCAPTCHA_SECRET is the PRIVATE key (backend verifies submissions with it)
# Leave both blank to disable captcha entirely.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Umami analytics (self-hosted at analytics.eukota.com).
# Generate both with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Set this AFTER the first deploy:
#   1. Visit https://analytics.eukota.com and log in (default: admin / umami — change it!)
#   2. Add a website named "Kinetic Time Machine" with domain kinetic.eukota.com
#   3. Copy its Website ID here, then rebuild the frontend container.
VITE_UMAMI_WEBSITE_ID=

# Automated photo moderation on upload
# - manual:     all uploads queue for human review (default without OPENAI_API_KEY)
# - openai:     OpenAI omni-moderation; auto-approve clean photos (default when key is set)
# - permissive: basic image checks only — auto-approve everything valid (local dev only)
MODERATION_MODE=
OPENAI_API_KEY=
